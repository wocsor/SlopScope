#!/usr/bin/env python3
"""Install the local USB package once, then launch its viewer bridge."""
import os
from pathlib import Path
import subprocess
import sys
import venv


def main():
    root = Path(__file__).resolve().parent
    if sys.version_info < (3, 11):
        raise SystemExit("SlopScope's bridge needs Python 3.11 or newer.")
    if os.name != "posix":
        raise SystemExit("The USB library currently supports macOS and Linux.")
    environment = root / ".venv-usb"
    python = environment / "bin/python"
    if not python.exists():
        print("Setting up SlopScope's USB environment…", flush=True)
        venv.EnvBuilder(with_pip=True).create(environment)
    ready = subprocess.run([str(python), "-c", "import slopscope_usb, numpy, usb"],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    if not ready:
        subprocess.run([str(python), "-m", "pip", "install", "--disable-pip-version-check",
                        "-e", str(root / "host")], check=True)
    os.execv(str(python), [str(python), "-m", "slopscope_usb", "bridge", *sys.argv[1:]])


if __name__ == "__main__":
    main()
